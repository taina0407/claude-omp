{
  "description": "omp plugin: remember the Claude session for omp jobs, optionally cancel them when it ends, keep the omp:job relay to `omp-task wait`, and the opt-in Stop review gate.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/omp-task\" hook session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/omp-task\" hook session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "i=$(cat); case \"$i\" in *omp:job*) printf '%s' \"$i\" | \"${CLAUDE_PLUGIN_ROOT}/bin/omp-task\" hook relay-guard || { echo \"omp relay guard failed; refusing the call\" >&2; exit 2; } ;; esac",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/omp-task\" hook stop-gate",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
