#!/usr/bin/env python3
"""omp-task: delegate coding tasks to the omp (oh-my-pi) agent and supervise them live.

Each task is a "job". A detached supervisor process drives `omp --mode rpc`, records
everything under the job directory, and exposes a control socket so the orchestrator
(e.g. Claude Code) can steer, abort, answer the worker's questions and approve shell
commands while the job runs. Events are pushed to a compact feed that `watch` streams
and `wait` returns on, so nobody has to poll.

Requires: Python >= 3.9, `omp` on PATH (or OMP_TASK_OMP_BIN). No third-party packages.
"""

from __future__ import annotations

import argparse
import json
import os
import queue
import re
import secrets
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

VERSION = "0.2.0"

SCRIPT_DIR = Path(__file__).resolve().parent
PREAMBLE_FILE = SCRIPT_DIR.parent / "prompts" / "worker-preamble.md"

# Access levels map onto omp's tool set and approval mode. In RPC mode omp sends
# approval prompts to us; the supervisor forwards them to the orchestrator.
ACCESS = {
    # Look, don't touch: no write/edit/bash tools at all.
    "read": [
        "--tools",
        "read,grep,find,glob,web_search,todo",
        "--approval-mode",
        "yolo",
    ],
    # File edits run freely; shell/eval commands need the orchestrator's approval.
    "edit": ["--approval-mode", "write"],
    # Everything, including shell (tests, installs). Use in a worktree or trusted tree.
    "full": ["--approval-mode", "yolo"],
}

HOST_TOOLS = [
    {
        "name": "ask_orchestrator",
        "label": "Ask orchestrator",
        "description": (
            "Ask the orchestrating agent that assigned this task a question and wait for its answer. "
            "Use it when the brief is ambiguous, a decision falls outside the brief, or you are blocked. "
            "Do not use it for things you can find out yourself by reading the code."
        ),
        "parameters": {
            "type": "object",
            "properties": {
                "question": {
                    "type": "string",
                    "description": "The question, self-contained.",
                },
                "options": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Optional candidate answers, most likely first.",
                },
                "context": {
                    "type": "string",
                    "description": "Optional short context the orchestrator needs.",
                },
            },
            "required": ["question"],
        },
        "loadMode": "essential",
    },
    {
        "name": "notify_orchestrator",
        "label": "Notify orchestrator",
        "description": (
            "Send a one-line progress note to the orchestrating agent without waiting for a reply. "
            "Use it only at meaningful milestones (plan made, main change done, tests running)."
        ),
        "parameters": {
            "type": "object",
            "properties": {"message": {"type": "string"}},
            "required": ["message"],
        },
        "loadMode": "essential",
    },
]
HOST_TOOL_NAMES = {t["name"] for t in HOST_TOOLS}

ACTIVE = {"queued", "starting", "running", "waiting"}
TERMINAL = {"completed", "failed", "timeout", "cancelled"}
RESULT_CHAR_LIMIT = 12000
FEED_TOOLS = {"write", "edit", "bash", "eval", "task"}
EXIT_ATTENTION = 4
EXIT_MAX_WAIT = 3


# ---------------------------------------------------------------- paths & config


def state_dir() -> Path:
    if os.environ.get("OMP_TASK_HOME"):
        return Path(os.environ["OMP_TASK_HOME"]).expanduser()
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(base) / "claude-omp"


def config_file() -> Path:
    if os.environ.get("OMP_TASK_CONFIG"):
        return Path(os.environ["OMP_TASK_CONFIG"]).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "claude-omp" / "config.json"


def load_config() -> dict:
    path = config_file()
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        die(f"invalid JSON in {path}: {exc}")
    return {}


def jobs_dir() -> Path:
    d = state_dir() / "jobs"
    d.mkdir(parents=True, exist_ok=True)
    return d


def omp_bin() -> str:
    candidate = os.environ.get("OMP_TASK_OMP_BIN", "omp")
    resolved = shutil.which(candidate)
    if not resolved:
        die(f"'{candidate}' not found on PATH. Install omp or set OMP_TASK_OMP_BIN.")
    return resolved


def die(msg: str, code: int = 2) -> None:
    print(f"omp-task: {msg}", file=sys.stderr)
    sys.exit(code)


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def parse_duration(value) -> float | None:
    """'90', '20m', '1h', '1h30m' -> seconds."""
    if value in (None, "", 0, "0"):
        return None
    if isinstance(value, (int, float)):
        return float(value)
    total, matched = 0.0, False
    for num, unit in re.findall(r"(\d+(?:\.\d+)?)\s*([hms]?)", str(value)):
        matched = True
        total += float(num) * {"h": 3600, "m": 60, "s": 1, "": 1}[unit]
    if not matched:
        die(f"bad duration: {value!r}")
    return total


# ---------------------------------------------------------------- job records


def new_job_id() -> str:
    return datetime.now().strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(2)


def job_path(job_id: str) -> Path:
    d = jobs_dir()
    exact = d / job_id
    if exact.is_dir():
        return exact
    matches = sorted(
        p for p in d.iterdir() if p.name.startswith(job_id) or p.name.endswith(job_id)
    )
    if len(matches) == 1:
        return matches[0]
    if not matches:
        die(f"no job matching '{job_id}'")
    die(f"'{job_id}' is ambiguous: " + ", ".join(m.name for m in matches[:5]))
    raise AssertionError


def read_meta(jdir: Path) -> dict:
    for _ in range(5):
        try:
            return json.loads((jdir / "meta.json").read_text())
        except (json.JSONDecodeError, FileNotFoundError):
            time.sleep(0.05)
    return json.loads((jdir / "meta.json").read_text())


def write_meta(jdir: Path, meta: dict) -> None:
    tmp = jdir / f"meta.json.{os.getpid()}.tmp"
    tmp.write_text(json.dumps(meta, indent=2, ensure_ascii=False))
    tmp.replace(jdir / "meta.json")


def pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def socket_path(jdir: Path) -> Path:
    candidate = jdir / "ctl.sock"
    if len(str(candidate)) < 100:  # AF_UNIX path limit is ~108 bytes
        return candidate
    alt = Path(tempfile.gettempdir()) / f"omp-task-{os.getuid()}"
    alt.mkdir(mode=0o700, exist_ok=True)
    return alt / f"{jdir.name}.sock"


def refresh_status(jdir: Path, meta: dict) -> dict:
    """A job whose supervisor died without finalising is reported as failed."""
    if (
        meta.get("status") in ACTIVE
        and meta.get("status") != "queued"
        and not pid_alive(meta.get("worker_pid"))
    ):
        meta = finalize_record(
            jdir, meta, "failed", ["supervisor exited without recording a result"]
        )
    return meta


def append_feed(jdir: Path, kind: str, text: str = "", **extra) -> None:
    entry = {"ts": now_iso(), "job": jdir.name, "kind": kind, "text": text, **extra}
    with (jdir / "feed.jsonl").open("a") as fh:
        fh.write(json.dumps(entry, ensure_ascii=False) + "\n")


# ---------------------------------------------------------------- git helpers


def git_root(cwd: Path) -> Path | None:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            capture_output=True,
            text=True,
            check=True,
        )
        return Path(out.stdout.strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def git_snapshot(cwd: Path) -> dict[str, str] | None:
    """Map of dirty path -> content hash, so we can tell which files the worker touched."""
    root = git_root(cwd)
    if not root:
        return None
    out = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
        cwd=root,
        capture_output=True,
        text=True,
    ).stdout
    paths = []
    entries = out.split("\0")
    i = 0
    while i < len(entries):
        entry = entries[i]
        if len(entry) > 3:
            paths.append(entry[3:])
            if entry[0] in "RC":  # rename/copy: next entry is the source path
                i += 1
        i += 1
    snap = {}
    for p in paths:
        f = root / p
        if f.is_file():
            h = subprocess.run(
                ["git", "hash-object", "--", str(f)], capture_output=True, text=True
            ).stdout.strip()
            snap[p] = h
        else:
            snap[p] = "<deleted>"
    return snap


def changed_files(before: dict | None, after: dict | None) -> list[str] | None:
    if before is None or after is None:
        return None
    keys = set(before) | set(after)
    return sorted(k for k in keys if before.get(k) != after.get(k))


def without_state_dir(files: list[str] | None, cwd: Path) -> list[str] | None:
    """Drop our own job records when the state dir happens to live inside the repo."""
    root = git_root(cwd)
    if files is None or root is None:
        return files
    try:
        rel = state_dir().resolve().relative_to(root.resolve()).as_posix() + "/"
    except ValueError:
        return files
    return [f for f in files if not f.startswith(rel)]


# ---------------------------------------------------------------- event parsing


def summarize_events(events_file: Path) -> dict:
    """Pull the useful bits out of omp's event stream (RPC frames or --mode json lines)."""
    info: dict = {
        "session_id": None,
        "final_text": "",
        "stop_reason": None,
        "tools": {},
        "cost_usd": 0.0,
        "tokens": 0,
        "model": None,
        "errors": [],
        "denied": [],
        "tool_errors": {},
    }
    if not events_file.exists():
        return info
    with events_file.open(errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            t = ev.get("type")
            if t == "session":
                info["session_id"] = ev.get("id")
            elif t == "tool_execution_start":
                name = ev.get("toolName", "?")
                info["tools"][name] = info["tools"].get(name, 0) + 1
            elif t == "tool_execution_end" and ev.get("isError"):
                name = ev.get("toolName")
                result = json.dumps(ev.get("result"))
                if "requires approval" in result or "denied" in result.lower():
                    if name not in info["denied"]:
                        info["denied"].append(name)
                else:
                    # Usually a non-zero exit (e.g. a failing test run): normal work, not a job error.
                    info["tool_errors"][name] = info["tool_errors"].get(name, 0) + 1
            elif t == "message_end":
                msg = ev.get("message") or {}
                if msg.get("role") == "assistant":
                    usage = msg.get("usage") or {}
                    info["tokens"] += usage.get("totalTokens") or 0
                    info["cost_usd"] += (usage.get("cost") or {}).get("total") or 0.0
                    info["model"] = f"{msg.get('provider')}/{msg.get('model')}"
                    info["stop_reason"] = msg.get("stopReason")
                    text = "".join(
                        c.get("text", "")
                        for c in msg.get("content") or []
                        if c.get("type") == "text"
                    ).strip()
                    if text:
                        info["final_text"] = text
                    if msg.get("errorMessage"):
                        info["errors"].append(str(msg["errorMessage"]))
    info["cost_usd"] = round(info["cost_usd"], 6)
    return info


def finalize_record(
    jdir: Path,
    meta: dict,
    status: str,
    errors: list[str] | None = None,
    exit_code: int | None = None,
) -> dict:
    """Write the final meta/result for a job. Safe to call from the supervisor or a reaper."""
    info = summarize_events(jdir / "events.jsonl")
    before = meta.pop("git_before", None)
    after = git_snapshot(Path(meta["cwd"])) if before is not None else None
    errs = info["errors"] + (errors or [])
    if status == "failed" and exit_code not in (None, 0):
        tail = (
            (jdir / "stderr.log").read_text(errors="replace")[-800:].strip()
            if (jdir / "stderr.log").exists()
            else ""
        )
        if tail:
            errs.append(tail)
    meta.update(
        status=status,
        exit_code=exit_code,
        finished_at=now_iso(),
        session_id=meta.get("session_id")
        or info["session_id"]
        or meta.get("resume_session"),
        model_used=info["model"],
        stop_reason=info["stop_reason"],
        tools=info["tools"],
        tool_errors=info["tool_errors"],
        tokens=info["tokens"],
        cost_usd=info["cost_usd"],
        errors=errs[-5:],
        denied_tools=sorted(set(info["denied"]) | set(meta.get("denied_tools") or [])),
        changed_files=without_state_dir(
            changed_files(before, after), Path(meta["cwd"])
        ),
        pending=[],
    )
    if meta.get("started_at_monotonic") is not None:
        meta["duration_s"] = round(
            time.monotonic() - meta.pop("started_at_monotonic"), 1
        )
    (jdir / "result.md").write_text(info["final_text"])
    write_meta(jdir, meta)
    append_feed(
        jdir,
        "done",
        status,
        changed_files=meta["changed_files"],
        cost_usd=meta["cost_usd"],
    )
    return meta


# ---------------------------------------------------------------- supervisor (omp --mode rpc)


class Supervisor:
    """Drives one omp RPC session for one job. Runs in its own detached process."""

    def __init__(self, jdir: Path):
        self.jdir = jdir
        self.meta = read_meta(jdir)
        self.q: queue.Queue = queue.Queue()
        self.proc: subprocess.Popen | None = None
        self.events = (jdir / "events.jsonl").open("a")
        self.pending: dict[str, dict] = {}  # request id -> pending question/approval
        self.abort_reason: str | None = None
        self.abort_deadline: float | None = None
        self.finished = False
        self.sock_path = socket_path(jdir)
        self.server: socket.socket | None = None
        self.started = time.monotonic()

    # -- plumbing

    def send(self, frame: dict) -> None:
        if self.proc and self.proc.stdin and not self.proc.stdin.closed:
            try:
                self.proc.stdin.write(json.dumps(frame) + "\n")
                self.proc.stdin.flush()
            except (BrokenPipeError, OSError):
                pass

    def save(self) -> None:
        self.meta["pending"] = list(self.pending.values())
        write_meta(self.jdir, self.meta)

    def feed(self, kind: str, text: str = "", **extra) -> None:
        append_feed(self.jdir, kind, text, **extra)

    def build_command(self) -> list[str]:
        m = self.meta
        cmd = [omp_bin(), "--mode", "rpc", "--no-title"]
        cmd += ACCESS[m["access"]]
        if m.get("model"):
            cmd += ["--model", m["model"]]
        if m.get("thinking"):
            cmd += ["--thinking", m["thinking"]]
        if m.get("resume_session"):
            cmd += ["--resume", m["resume_session"]]
        elif PREAMBLE_FILE.exists() and not m.get("no_preamble"):
            cmd += ["--append-system-prompt", str(PREAMBLE_FILE)]
        for d in m.get("add_dirs") or []:
            cmd += ["--add-dir", d]
        cmd += m.get("extra_args") or []
        return cmd

    def prompt_text(self) -> str:
        text = (self.jdir / "prompt.md").read_text()
        files = self.meta.get("files") or []
        if files:
            text += "\n\nAttached files (read them first):\n" + "\n".join(
                f"- {f}" for f in files
            )
        return text

    def reader(self) -> None:
        assert self.proc and self.proc.stdout
        for line in self.proc.stdout:
            self.q.put(("omp", line))
        self.q.put(("eof", None))

    def serve(self) -> None:
        assert self.server
        while True:
            try:
                conn, _ = self.server.accept()
            except OSError:
                return
            threading.Thread(target=self.handle_conn, args=(conn,), daemon=True).start()

    def handle_conn(self, conn: socket.socket) -> None:
        with conn:
            conn.settimeout(10)
            buf = b""
            while not buf.endswith(b"\n"):
                chunk = conn.recv(65536)
                if not chunk:
                    break
                buf += chunk
            try:
                cmd = json.loads(buf.decode() or "{}")
            except json.JSONDecodeError:
                conn.sendall(b'{"ok": false, "error": "bad request"}\n')
                return
            box: queue.Queue = queue.Queue()
            self.q.put(("ctl", (cmd, box)))
            try:
                reply = box.get(timeout=10)
            except queue.Empty:
                reply = {"ok": False, "error": "supervisor busy"}
            conn.sendall((json.dumps(reply) + "\n").encode())

    # -- lifecycle

    def run(self) -> dict:
        cwd = Path(self.meta["cwd"])
        self.meta["git_before"] = git_snapshot(cwd)
        cmd = self.build_command()
        try:
            self.sock_path.unlink()
        except FileNotFoundError:
            pass
        self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.server.bind(str(self.sock_path))
        os.chmod(self.sock_path, 0o600)
        self.server.listen(8)

        stderr = (self.jdir / "stderr.log").open("w")
        self.proc = subprocess.Popen(
            cmd,
            cwd=cwd,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=stderr,
            text=True,
            bufsize=1,
            start_new_session=True,
        )
        self.meta.update(
            status="starting",
            started_at=now_iso(),
            command=cmd,
            worker_pid=os.getpid(),
            omp_pid=self.proc.pid,
            socket=str(self.sock_path),
        )
        self.save()
        threading.Thread(target=self.reader, daemon=True).start()
        threading.Thread(target=self.serve, daemon=True).start()
        signal.signal(
            signal.SIGTERM,
            lambda *_: self.q.put(("ctl", ({"cmd": "abort"}, queue.Queue()))),
        )

        timeout = parse_duration(self.meta.get("timeout"))
        deadline = self.started + timeout if timeout else None
        while not self.finished:
            try:
                kind, payload = self.q.get(timeout=1)
            except queue.Empty:
                kind, payload = "tick", None
            now = time.monotonic()
            if kind == "omp":
                self.events.write(payload)
                self.events.flush()
                try:
                    frame = json.loads(payload)
                except json.JSONDecodeError:
                    continue
                self.on_frame(frame)
            elif kind == "ctl":
                cmd_, box = payload
                box.put(self.on_control(cmd_))
            elif kind == "eof":
                if not self.finished:
                    code = self.proc.wait()
                    self.finish(
                        "cancelled"
                        if self.abort_reason == "cancelled"
                        else "timeout"
                        if self.abort_reason == "timeout"
                        else "failed",
                        exit_code=code,
                        errors=[] if self.abort_reason else ["omp exited unexpectedly"],
                    )
            if self.finished:
                break
            if deadline and now > deadline and not self.abort_reason:
                self.feed(
                    "timeout", f"hit --timeout {self.meta.get('timeout')}; aborting"
                )
                self.abort("timeout")
            if self.abort_deadline and now > self.abort_deadline:
                self.finish(self.abort_reason or "cancelled")
            self.expire_pending(now)
        return self.meta

    def abort(self, reason: str) -> None:
        self.abort_reason = reason
        self.abort_deadline = time.monotonic() + 15
        self.send({"id": "abort", "type": "abort"})
        for pid, item in list(self.pending.items()):
            self.resolve_pending(pid, "Task aborted by orchestrator.", deny=True)

    def finish(
        self, status: str, exit_code: int | None = None, errors: list[str] | None = None
    ) -> None:
        if self.finished:
            return
        self.finished = True
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.stdin.close()
            except OSError:
                pass
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(self.proc.pid, signal.SIGTERM)
                    self.proc.wait(timeout=5)
                except (ProcessLookupError, subprocess.TimeoutExpired):
                    try:
                        os.killpg(self.proc.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
        if exit_code is None and self.proc:
            exit_code = self.proc.poll()
        self.pending.clear()
        self.meta["started_at_monotonic"] = self.started
        self.meta.pop("worker_pid", None)
        self.meta = finalize_record(self.jdir, self.meta, status, errors, exit_code)
        if self.server:
            self.server.close()
        try:
            self.sock_path.unlink()
        except FileNotFoundError:
            pass

    # -- omp → us

    def on_frame(self, f: dict) -> None:
        t = f.get("type")
        if t == "ready":
            self.send(
                {"id": "host_tools", "type": "set_host_tools", "tools": HOST_TOOLS}
            )
            self.send({"id": "state0", "type": "get_state"})
            self.send(
                {"id": "prompt0", "type": "prompt", "message": self.prompt_text()}
            )
            self.meta["status"] = "running"
            self.save()
            self.feed(
                "started",
                self.meta.get("title", ""),
                model=self.meta.get("model"),
                access=self.meta.get("access"),
            )
        elif t == "response":
            if f.get("id") == "state0" and f.get("success"):
                data = f.get("data") or {}
                self.meta["session_id"] = data.get("sessionId")
                model = data.get("model") or {}
                if model:
                    self.meta["model_resolved"] = (
                        f"{model.get('provider')}/{model.get('id')}"
                    )
                self.save()
            elif not f.get("success"):
                self.feed("error", f"{f.get('command')}: {f.get('error')}")
                if f.get("id") == "prompt0":
                    self.finish("failed", errors=[f"prompt rejected: {f.get('error')}"])
        elif t == "tool_execution_start":
            name = f.get("toolName")
            args = f.get("args") or {}
            if name in FEED_TOOLS:
                detail = (
                    args.get("path")
                    or args.get("command")
                    or args.get("description")
                    or f.get("intent")
                    or ""
                )
                self.feed("tool", f"{name}: {str(detail)[:160]}")
        elif t == "host_tool_call":
            self.on_host_tool(f)
        elif t == "host_tool_cancel":
            if self.pending.pop(f.get("targetId"), None):
                self.feed("info", "worker withdrew its question")
                self.update_waiting()
        elif t == "extension_ui_request":
            self.on_ui_request(f)
        elif t == "message_end":
            msg = f.get("message") or {}
            if msg.get("role") == "assistant" and msg.get("errorMessage"):
                self.feed("error", str(msg["errorMessage"])[:300])
        elif t == "agent_end":
            if f.get("isTerminal") is False:
                return
            stop = None
            for msg in reversed(f.get("messages") or []):
                if msg.get("role") == "assistant":
                    stop = msg.get("stopReason")
                    break
            if self.abort_reason:
                self.finish(self.abort_reason)
            elif stop == "error":
                self.finish("failed")
            else:
                self.finish("completed")

    def on_host_tool(self, f: dict) -> None:
        name, args = f.get("toolName"), f.get("arguments") or {}
        if name == "notify_orchestrator":
            self.feed("progress", str(args.get("message", ""))[:300])
            self.send(
                {
                    "type": "host_tool_result",
                    "id": f["id"],
                    "result": {"content": [{"type": "text", "text": "Noted."}]},
                }
            )
        elif name == "ask_orchestrator":
            item = {
                "id": f["id"],
                "kind": "question",
                "text": args.get("question", ""),
                "options": args.get("options") or [],
                "context": args.get("context"),
                "since": time.monotonic(),
                "asked_at": now_iso(),
            }
            self.pending[f["id"]] = item
            self.update_waiting()
            self.feed(
                "question",
                item["text"],
                ref=f["id"],
                options=item["options"],
                context=item["context"],
            )
        else:
            self.send(
                {
                    "type": "host_tool_result",
                    "id": f["id"],
                    "isError": True,
                    "result": {
                        "content": [
                            {"type": "text", "text": f"unknown host tool {name}"}
                        ]
                    },
                }
            )

    def on_ui_request(self, f: dict) -> None:
        method = f.get("method")
        if method not in ("select", "confirm", "input", "editor"):
            return  # notify/setStatus/setWidget/...: display only
        title = f.get("title") or ""
        m = re.match(r"Allow tool: (\S+)", title)
        if method == "select" and m:
            tool = m.group(1)
            options = f.get("options") or []
            if tool in HOST_TOOL_NAMES:
                session_opt = next(
                    (o for o in options if "session" in o.lower()),
                    options[0] if options else "Approve",
                )
                self.send(
                    {
                        "type": "extension_ui_response",
                        "id": f["id"],
                        "value": session_opt,
                    }
                )
                return
            detail = title.split("\n", 1)[1].strip() if "\n" in title else ""
            item = {
                "id": f["id"],
                "kind": "approval",
                "tool": tool,
                "text": detail or tool,
                "options": options,
                "since": time.monotonic(),
                "asked_at": now_iso(),
            }
            self.pending[f["id"]] = item
            self.update_waiting()
            self.feed("approval", f"{tool}: {detail}"[:300], ref=f["id"], tool=tool)
            return
        # Any other interactive prompt: there is no human here, cancel it.
        self.send({"type": "extension_ui_response", "id": f["id"], "cancelled": True})

    def update_waiting(self) -> None:
        if self.finished:
            return
        self.meta["status"] = "waiting" if self.pending else "running"
        self.save()

    def expire_pending(self, now: float) -> None:
        limits = {
            "question": parse_duration(self.meta.get("answer_timeout")),
            "approval": parse_duration(self.meta.get("approval_timeout")),
        }
        for pid, item in list(self.pending.items()):
            limit = limits.get(item["kind"])
            if limit and now - item["since"] > limit:
                if item["kind"] == "question":
                    self.resolve_pending(
                        pid,
                        "No answer from the orchestrator in time. Make the most reasonable "
                        "assumption, continue, and list the assumption under Open issues.",
                    )
                else:
                    self.resolve_pending(pid, None, deny=True)
                self.feed("info", f"{item['kind']} {pid} expired without a reply")

    def resolve_pending(
        self, pid: str, answer: str | None, deny: bool = False, session: bool = False
    ) -> None:
        item = self.pending.pop(pid, None)
        if not item:
            return
        if item["kind"] == "question":
            self.send(
                {
                    "type": "host_tool_result",
                    "id": pid,
                    "result": {"content": [{"type": "text", "text": answer or ""}]},
                }
            )
        else:
            options = item.get("options") or []
            if deny:
                value = next(
                    (o for o in options if o.lower().startswith("deny")), "Deny"
                )
                denied = set(self.meta.get("denied_tools") or [])
                denied.add(item.get("tool"))
                self.meta["denied_tools"] = sorted(d for d in denied if d)
            elif session:
                value = next((o for o in options if "session" in o.lower()), "Approve")
            else:
                value = next(
                    (o for o in options if o.lower() == "approve"),
                    options[0] if options else "Approve",
                )
            self.send({"type": "extension_ui_response", "id": pid, "value": value})
        self.update_waiting()

    # -- orchestrator → us

    def on_control(self, c: dict) -> dict:
        cmd = c.get("cmd")
        if self.finished:
            return {"ok": False, "error": f"job already {self.meta.get('status')}"}
        if cmd == "state":
            return {
                "ok": True,
                "status": self.meta.get("status"),
                "pending": list(self.pending.values()),
            }
        if cmd == "steer":
            self.send({"type": "steer", "message": c.get("message", "")})
            self.feed("steer", c.get("message", "")[:300])
            return {"ok": True}
        if cmd == "abort":
            self.feed("abort", "cancel requested")
            self.abort("cancelled")
            return {"ok": True}
        if cmd in ("reply", "approve"):
            kind = "question" if cmd == "reply" else "approval"
            ref = c.get("ref")
            candidates = [
                p
                for p in self.pending.values()
                if p["kind"] == kind and (not ref or p["id"] == ref)
            ]
            if not candidates:
                return {
                    "ok": False,
                    "error": f"no pending {kind}" + (f" with ref {ref}" if ref else ""),
                }
            item = candidates[0]
            if cmd == "reply":
                self.resolve_pending(item["id"], c.get("message", ""))
                self.feed("answered", c.get("message", "")[:300], ref=item["id"])
            else:
                decision = c.get("decision", "approve")
                self.resolve_pending(
                    item["id"],
                    None,
                    deny=decision == "deny",
                    session=decision == "session",
                )
                self.feed(
                    "approval-" + decision, item.get("text", "")[:200], ref=item["id"]
                )
            return {"ok": True, "ref": item["id"]}
        return {"ok": False, "error": f"unknown command {cmd!r}"}


def control(jdir: Path, payload: dict) -> dict:
    meta = read_meta(jdir)
    path = meta.get("socket")
    if not path or meta.get("status") not in ACTIVE:
        die(f"job {meta['id']} is {meta.get('status')}, not running")
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(15)
    try:
        s.connect(path)
        s.sendall((json.dumps(payload) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            buf += chunk
    except OSError as exc:
        die(f"cannot reach job {meta['id']} supervisor: {exc}")
    finally:
        s.close()
    return json.loads(buf.decode() or '{"ok": false, "error": "no reply"}')


# ---------------------------------------------------------------- job creation


def prepare_job(args, prompt: str, parent: dict | None = None) -> Path:
    cfg = load_config()
    preset = {}
    if getattr(args, "preset", None):
        preset = (cfg.get("presets") or {}).get(args.preset)
        if preset is None:
            die(f"unknown preset '{args.preset}' (define it in {config_file()})")
    defaults = cfg.get("defaults") or {}

    def pick(key, fallback=None):
        val = getattr(args, key, None)
        if val is not None:
            return val
        if key in preset:
            return preset[key]
        if parent and parent.get(key) is not None:
            return parent[key]
        return defaults.get(key, fallback)

    cwd = Path(args.cwd or (parent or {}).get("cwd") or os.getcwd()).resolve()
    if not cwd.is_dir():
        die(f"cwd does not exist: {cwd}")

    job_id = new_job_id()
    jdir = jobs_dir() / job_id
    jdir.mkdir()
    (jdir / "prompt.md").write_text(prompt)
    (jdir / "feed.jsonl").touch()
    meta = {
        "id": job_id,
        "version": VERSION,
        "status": "queued",
        "created_at": now_iso(),
        "cwd": str(cwd),
        "title": args.title or first_line(prompt),
        "access": pick("access", "edit"),
        "model": pick("model"),
        "thinking": pick("thinking"),
        "timeout": pick("timeout", "30m"),
        "answer_timeout": pick("answer_timeout", "20m"),
        "approval_timeout": pick("approval_timeout", "20m"),
        "add_dirs": [str(Path(d).resolve()) for d in (args.add_dir or [])],
        "files": [str(Path(f).resolve()) for f in (getattr(args, "file", None) or [])],
        "extra_args": shlex.split(pick("omp_args", "") or ""),
        "no_preamble": bool(getattr(args, "no_preamble", False)),
        "parent": parent["id"] if parent else None,
        "resume_session": parent.get("session_id") if parent else None,
    }
    if meta["access"] not in ACCESS:
        die(f"access must be one of {', '.join(ACCESS)}")
    write_meta(jdir, meta)
    return jdir


def first_line(text: str) -> str:
    for line in text.splitlines():
        line = re.sub(r"^[#>*\-\s]+", "", line).strip()
        if line:
            return line[:80]
    return "(untitled)"


def spawn_supervisor(jdir: Path) -> int:
    log = (jdir / "supervisor.log").open("w")
    proc = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "_supervise", str(jdir)],
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=log,
        start_new_session=True,
    )
    meta = read_meta(jdir)
    meta.update(status="starting", worker_pid=proc.pid)
    write_meta(jdir, meta)
    return proc.pid


def launch(jdir: Path, args) -> int:
    pid = spawn_supervisor(jdir)
    job_id = jdir.name
    if args.detach:
        if args.json:
            print(json.dumps({"id": job_id, "status": "starting", "pid": pid}))
        else:
            print(f"job {job_id} started (supervisor pid {pid})")
            print(
                f"  wake me when it needs me: omp-task wait {job_id}   (run it in the background)"
            )
            print(f"  live feed for Monitor:    omp-task watch {job_id}")
        return 0
    return wait_jobs(
        [jdir], interval=0.5, max_wait=args.max_wait, as_json=args.json, attention=True
    )


# ---------------------------------------------------------------- output


def emit(jdir: Path, meta: dict, as_json: bool, full: bool = False) -> None:
    result = (jdir / "result.md").read_text() if (jdir / "result.md").exists() else ""
    truncated = False
    if not full and len(result) > RESULT_CHAR_LIMIT:
        result = result[:RESULT_CHAR_LIMIT]
        truncated = True
    pending = [
        {k: v for k, v in p.items() if k != "since"} for p in meta.get("pending") or []
    ]
    if as_json:
        keys = [
            "id",
            "status",
            "title",
            "cwd",
            "access",
            "model",
            "model_used",
            "session_id",
            "parent",
            "duration_s",
            "cost_usd",
            "tokens",
            "tools",
            "tool_errors",
            "changed_files",
            "denied_tools",
            "errors",
            "created_at",
            "finished_at",
        ]
        out = {k: meta.get(k) for k in keys}
        out["pending"] = pending
        out["result"] = result
        out["result_truncated"] = truncated
        out["job_dir"] = str(jdir)
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return
    print(f"## omp job {meta['id']} — {meta.get('status', '?').upper()}")
    print(f"- title: {meta.get('title')}")
    print(f"- cwd: {meta.get('cwd')}  access: {meta.get('access')}")
    model = (
        meta.get("model_used")
        or meta.get("model_resolved")
        or meta.get("model")
        or "(omp default)"
    )
    print(f"- model: {model}  session: {meta.get('session_id') or '-'}")
    if meta.get("duration_s") is not None:
        print(
            f"- duration: {meta['duration_s']}s  tokens: {meta.get('tokens', 0)}  cost: ${meta.get('cost_usd', 0):.4f}"
        )
    if meta.get("tools"):
        print(
            "- tools: "
            + ", ".join(f"{k}×{v}" for k, v in sorted(meta["tools"].items()))
        )
    if meta.get("tool_errors"):
        print(
            "- tool calls that returned an error: "
            + ", ".join(f"{k}×{v}" for k, v in sorted(meta["tool_errors"].items()))
        )
    cf = meta.get("changed_files")
    if cf is not None:
        print("- changed files: " + (", ".join(cf) if cf else "(none)"))
    if meta.get("denied_tools"):
        print(f"- denied: " + ", ".join(meta["denied_tools"]))
    for e in meta.get("errors") or []:
        print(f"- error: {e}")
    if pending:
        print()
        print_pending(meta["id"], pending)
        return
    print()
    print(result or "(no final message)")
    if truncated:
        print(f"\n[truncated — full text: omp-task result {meta['id']} --full]")


def print_pending(job_id: str, pending: list[dict]) -> None:
    for p in pending:
        if p["kind"] == "question":
            print(f"QUESTION from worker (ref {p['id']}): {p['text']}")
            if p.get("context"):
                print(f"  context: {p['context']}")
            for o in p.get("options") or []:
                print(f"  - option: {o}")
            print(f'  answer:  omp-task reply {job_id} "<answer>"')
        else:
            print(f"APPROVAL needed (ref {p['id']}): {p.get('tool')} — {p['text']}")
            print(f"  decide:  omp-task approve {job_id} [--session | --deny]")


def format_feed(entry: dict) -> str:
    ts = entry.get("ts", "")[11:19]
    kind = entry.get("kind", "?").upper()
    text = entry.get("text", "")
    line = f"{ts} {entry.get('job')} {kind}: {text}"
    if entry.get("kind") == "question":
        opts = entry.get("options") or []
        if opts:
            line += "  [options: " + " | ".join(opts) + "]"
        line += f'  → omp-task reply {entry.get("job")} "..."'
    elif entry.get("kind") == "approval":
        line += f"  → omp-task approve {entry.get('job')} [--session|--deny]"
    elif entry.get("kind") == "done":
        cf = entry.get("changed_files")
        if cf is not None:
            line += f"  changed: {', '.join(cf) or '(none)'}"
        line += f"  → omp-task result {entry.get('job')}"
    return line


# ---------------------------------------------------------------- commands


def read_prompt(args) -> str:
    parts = []
    if getattr(args, "brief", None):
        parts.append(
            sys.stdin.read() if args.brief == "-" else Path(args.brief).read_text()
        )
    if getattr(args, "prompt", None):
        parts.append(" ".join(args.prompt))
    text = "\n\n".join(p.strip() for p in parts if p.strip())
    if not text:
        die("no text given: pass it as arguments, or --brief FILE (use '-' for stdin)")
    return text


def cmd_run(args) -> int:
    jdir = prepare_job(args, read_prompt(args))
    return launch(jdir, args)


def cmd_continue(args) -> int:
    parent_dir = job_path(args.job)
    parent = refresh_status(parent_dir, read_meta(parent_dir))
    if parent.get("status") in ACTIVE:
        die(
            f"job {parent['id']} is still {parent['status']}; use steer/reply/approve, or wait for it"
        )
    if not parent.get("session_id"):
        die(f"job {parent['id']} has no omp session to continue")
    jdir = prepare_job(args, read_prompt(args), parent=parent)
    return launch(jdir, args)


def cmd_steer(args) -> int:
    reply = control(job_path(args.job), {"cmd": "steer", "message": read_prompt(args)})
    print("steer sent" if reply.get("ok") else f"error: {reply.get('error')}")
    return 0 if reply.get("ok") else 1


def cmd_reply(args) -> int:
    reply = control(
        job_path(args.job),
        {"cmd": "reply", "message": read_prompt(args), "ref": args.ref},
    )
    print("answer sent" if reply.get("ok") else f"error: {reply.get('error')}")
    return 0 if reply.get("ok") else 1


def cmd_approve(args) -> int:
    decision = "deny" if args.deny else "session" if args.session else "approve"
    reply = control(
        job_path(args.job), {"cmd": "approve", "decision": decision, "ref": args.ref}
    )
    print(f"{decision} sent" if reply.get("ok") else f"error: {reply.get('error')}")
    return 0 if reply.get("ok") else 1


def cmd_cancel(args) -> int:
    jdir = job_path(args.job)
    meta = refresh_status(jdir, read_meta(jdir))
    if meta.get("status") in TERMINAL:
        print(f"job {meta['id']} already {meta['status']}")
        return 0
    try:
        reply = control(jdir, {"cmd": "abort"})
        if reply.get("ok"):
            print(f"cancel requested for job {meta['id']}")
            return 0
    except SystemExit:
        pass
    for key in ("omp_pid", "worker_pid"):
        pid = meta.get(key)
        if pid_alive(pid):
            try:
                os.killpg(pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
    print(f"job {meta['id']} killed")
    return 0


def cmd_status(args) -> int:
    jdir = job_path(args.job)
    meta = refresh_status(jdir, read_meta(jdir))
    if meta["status"] in TERMINAL or meta.get("pending"):
        emit(jdir, meta, args.json)
        return 0
    info = summarize_events(jdir / "events.jsonl")
    snapshot = {
        "id": meta["id"],
        "status": meta["status"],
        "title": meta.get("title"),
        "started_at": meta.get("started_at"),
        "tools_so_far": info["tools"],
        "session_id": meta.get("session_id"),
    }
    print(
        json.dumps(snapshot, indent=2)
        if args.json
        else f"{meta['id']} {meta['status']} — {meta.get('title')} — tools so far: "
        + (", ".join(f"{k}×{v}" for k, v in info["tools"].items()) or "none")
    )
    return 0


def wait_jobs(
    dirs: list[Path],
    interval: float,
    max_wait: float | None,
    as_json: bool,
    attention: bool,
) -> int:
    deadline = time.monotonic() + max_wait if max_wait else None
    while True:
        metas = [refresh_status(d, read_meta(d)) for d in dirs]
        needs = (
            [(d, m) for d, m in zip(dirs, metas) if m.get("pending")]
            if attention
            else []
        )
        if needs:
            for d, m in needs:
                emit(d, m, as_json)
                print()
            others = [m for m in metas if not m.get("pending")]
            for m in others:
                print(f"(job {m['id']} is {m['status']})")
            return EXIT_ATTENTION
        if all(m["status"] in TERMINAL for m in metas):
            break
        if deadline and time.monotonic() > deadline:
            for m in metas:
                print(f"{m['id']} {m['status']}")
            return EXIT_MAX_WAIT
        time.sleep(interval)
    for d, m in zip(dirs, metas):
        emit(d, m, as_json)
        print()
    return 0 if all(m["status"] == "completed" for m in metas) else 1


def cmd_wait(args) -> int:
    return wait_jobs(
        [job_path(j) for j in args.jobs],
        args.interval,
        args.max_wait,
        args.json,
        attention=not args.no_attention,
    )


def cmd_watch(args) -> int:
    dirs = [job_path(j) for j in args.jobs]
    offsets = {}
    for d in dirs:
        feed = d / "feed.jsonl"
        offsets[d] = 0 if args.from_start or not feed.exists() else feed.stat().st_size
    if not args.from_start:
        # Surface anything already waiting on us, so a late watcher does not miss it.
        for d in dirs:
            meta = read_meta(d)
            for p in meta.get("pending") or []:
                print(
                    format_feed(
                        {
                            "ts": p.get("asked_at", ""),
                            "job": d.name,
                            "kind": p["kind"],
                            "text": p["text"],
                            "options": p.get("options"),
                        }
                    ),
                    flush=True,
                )
    while True:
        for d in dirs:
            feed = d / "feed.jsonl"
            if not feed.exists():
                continue
            with feed.open() as fh:
                fh.seek(offsets[d])
                while True:
                    line = fh.readline()
                    if not line.endswith("\n"):
                        break
                    offsets[d] += len(line.encode())
                    try:
                        entry = json.loads(line)
                    except json.JSONDecodeError:
                        continue
                    if args.quiet and entry.get("kind") in (
                        "tool",
                        "progress",
                        "steer",
                    ):
                        continue
                    print(format_feed(entry), flush=True)
        metas = [refresh_status(d, read_meta(d)) for d in dirs]
        if all(m["status"] in TERMINAL for m in metas):
            # Drain once more: the done line may have landed after the last read.
            if all(offsets[d] >= (d / "feed.jsonl").stat().st_size for d in dirs):
                return 0
            continue
        time.sleep(args.interval)


def cmd_result(args) -> int:
    jdir = job_path(args.job)
    meta = refresh_status(jdir, read_meta(jdir))
    emit(jdir, meta, args.json, full=args.full)
    return 0


def cmd_list(args) -> int:
    rows = []
    for d in sorted(jobs_dir().iterdir(), reverse=True):
        if not (d / "meta.json").exists():
            continue
        meta = refresh_status(d, read_meta(d))
        if args.cwd and meta.get("cwd") != str(Path(args.cwd).resolve()):
            continue
        if args.status and meta.get("status") != args.status:
            continue
        rows.append(meta)
        if len(rows) >= args.limit:
            break
    if args.json:
        print(
            json.dumps(
                [
                    {
                        k: m.get(k)
                        for k in (
                            "id",
                            "status",
                            "title",
                            "cwd",
                            "model_used",
                            "cost_usd",
                            "parent",
                        )
                    }
                    for m in rows
                ],
                indent=2,
            )
        )
        return 0
    for m in rows:
        print(
            f"{m['id']}  {m.get('status', '?'):<9}  {m.get('title', '')[:60]}  [{m.get('cwd')}]"
        )
    if not rows:
        print("(no jobs)")
    return 0


def cmd_doctor(args) -> int:
    ok = True
    binary = shutil.which(os.environ.get("OMP_TASK_OMP_BIN", "omp"))
    print(f"omp binary:   {binary or 'NOT FOUND'}")
    ok &= bool(binary)
    if binary:
        ver = subprocess.run(
            [binary, "--version"], capture_output=True, text=True
        ).stdout.strip()
        print(f"omp version:  {ver}")
    print(f"python:       {sys.version.split()[0]}")
    print(f"state dir:    {state_dir()}")
    cfg = config_file()
    print(
        f"config:       {cfg} ({'present' if cfg.exists() else 'absent, using defaults'})"
    )
    presets = load_config().get("presets") or {}
    if presets:
        print("presets:      " + ", ".join(presets))
    print(
        f"preamble:     {PREAMBLE_FILE} ({'ok' if PREAMBLE_FILE.exists() else 'missing'})"
    )
    return 0 if ok else 1


def cmd_supervise(args) -> int:
    Supervisor(Path(args.job_dir)).run()
    return 0


# ---------------------------------------------------------------- CLI


def add_task_args(p: argparse.ArgumentParser) -> None:
    p.add_argument(
        "prompt", nargs="*", help="task text (combined with --brief if both given)"
    )
    p.add_argument("-b", "--brief", help="read the task from a file ('-' for stdin)")
    p.add_argument(
        "-m",
        "--model",
        help="omp model or role: e.g. smol, slow, plan, task, 'openai/gpt-6-luna'",
    )
    p.add_argument("-p", "--preset", help="named preset from the config file")
    p.add_argument(
        "-a", "--access", choices=list(ACCESS), help="read | edit (default) | full"
    )
    p.add_argument(
        "-t", "--thinking", help="off|minimal|low|medium|high|xhigh|max|auto"
    )
    p.add_argument(
        "--timeout",
        help="wall-clock limit for the job, e.g. 600, 20m, 1h (default 30m)",
    )
    p.add_argument(
        "--answer-timeout",
        help="how long the worker waits for a reply to a question (default 20m)",
    )
    p.add_argument(
        "--approval-timeout",
        help="how long a shell approval waits before it is denied (default 20m)",
    )
    p.add_argument("-C", "--cwd", help="directory omp works in (default: current)")
    p.add_argument(
        "--add-dir", action="append", help="extra workspace directory (repeatable)"
    )
    p.add_argument(
        "-f",
        "--file",
        action="append",
        help="file the worker should read first (repeatable)",
    )
    p.add_argument("--title", help="short label for job listings")
    p.add_argument("--omp-args", help="extra raw omp flags, shell-quoted")
    p.add_argument(
        "--no-preamble",
        action="store_true",
        help="skip the worker preamble system prompt",
    )
    p.add_argument(
        "-d",
        "--detach",
        action="store_true",
        help="return the job id at once instead of waiting",
    )
    p.add_argument(
        "--max-wait",
        type=float,
        help="without --detach: stop waiting after N seconds (exit 3)",
    )
    p.add_argument("--json", action="store_true", help="machine-readable output")


def add_message_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("job")
    p.add_argument("prompt", nargs="*", help="message text")
    p.add_argument("-b", "--brief", help="read the message from a file ('-' for stdin)")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="omp-task",
        description=__doc__.splitlines()[0],
        epilog="Exit codes: 0 completed, 1 failed/cancelled/timeout, 2 usage error, "
        "3 --max-wait expired, 4 a job is waiting for an answer or approval.",
    )
    parser.add_argument("--version", action="version", version=f"omp-task {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True, metavar="<command>")

    p = sub.add_parser(
        "run",
        help="start a task; waits until it finishes or needs you (unless --detach)",
    )
    add_task_args(p)
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser(
        "continue", help="new job that resumes a finished job's omp session"
    )
    p.add_argument("job")
    add_task_args(p)
    p.set_defaults(fn=cmd_continue)

    p = sub.add_parser(
        "wait", help="block until jobs finish or one needs an answer/approval (exit 4)"
    )
    p.add_argument("jobs", nargs="+")
    p.add_argument("--interval", type=float, default=1.0)
    p.add_argument("--max-wait", type=float, help="give up after N seconds (exit 3)")
    p.add_argument(
        "--no-attention",
        action="store_true",
        help="do not return early for questions/approvals",
    )
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_wait)

    p = sub.add_parser(
        "watch", help="stream one line per job event until all jobs end (for Monitor)"
    )
    p.add_argument("jobs", nargs="+")
    p.add_argument(
        "--from-start", action="store_true", help="replay the feed from the beginning"
    )
    p.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="only questions, approvals, errors and ends",
    )
    p.add_argument("--interval", type=float, default=0.5)
    p.set_defaults(fn=cmd_watch)

    p = sub.add_parser("steer", help="redirect a running job mid-flight")
    add_message_args(p)
    p.set_defaults(fn=cmd_steer)

    p = sub.add_parser("reply", help="answer a running job's ask_orchestrator question")
    add_message_args(p)
    p.add_argument("--ref", help="which question (default: the oldest pending)")
    p.set_defaults(fn=cmd_reply)

    p = sub.add_parser(
        "approve", help="approve (or deny) a running job's pending shell command"
    )
    p.add_argument("job")
    g = p.add_mutually_exclusive_group()
    g.add_argument(
        "--session",
        action="store_true",
        help="approve this tool for the rest of the job",
    )
    g.add_argument("--deny", action="store_true")
    p.add_argument("--ref", help="which approval (default: the oldest pending)")
    p.set_defaults(fn=cmd_approve)

    p = sub.add_parser("cancel", help="abort a running job")
    p.add_argument("job")
    p.set_defaults(fn=cmd_cancel)

    p = sub.add_parser(
        "status", help="show a job's state (pending questions, live tool counts)"
    )
    p.add_argument("job")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("result", help="print a job's result")
    p.add_argument("job")
    p.add_argument(
        "--full", action="store_true", help="do not truncate the final message"
    )
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_result)

    p = sub.add_parser("list", help="list recent jobs")
    p.add_argument("-n", "--limit", type=int, default=20)
    p.add_argument("-C", "--cwd", help="only jobs for this directory")
    p.add_argument("--status", choices=sorted(TERMINAL | ACTIVE))
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("doctor", help="check the omp install and configuration")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("_supervise")  # internal: the detached per-job supervisor
    p.add_argument("job_dir")
    p.set_defaults(fn=cmd_supervise)

    args = parser.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
