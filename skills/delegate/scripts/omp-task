#!/usr/bin/env python3
"""omp-task: delegate coding tasks to the omp (oh-my-pi) agent and collect compact results.

Designed to be driven by an orchestrating agent (e.g. Claude Code) but usable by hand.
Every run is recorded as a "job" under the state directory, so results can be read,
continued (same omp session), listed and cancelled later.

Requires: Python >= 3.9, `omp` on PATH (or OMP_TASK_OMP_BIN). No third-party packages.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

VERSION = "0.1.0"

SCRIPT_DIR = Path(__file__).resolve().parent
PREAMBLE_FILE = SCRIPT_DIR.parent / "prompts" / "worker-preamble.md"

# Access levels map onto omp's tool set and approval mode. Headless omp cannot
# answer approval prompts, so anything that would prompt is denied.
ACCESS = {
    # Look, don't touch: no write/edit/bash tools at all.
    "read": ["--tools", "read,grep,find,glob,web_search,todo", "--approval-mode", "yolo"],
    # File edits allowed, shell commands denied.
    "edit": ["--approval-mode", "write"],
    # Everything, including shell (tests, installs). Use in a worktree or trusted tree.
    "full": ["--approval-mode", "yolo"],
}

TERMINAL = {"completed", "failed", "timeout", "cancelled"}
RESULT_CHAR_LIMIT = 12000


# ---------------------------------------------------------------- paths & config


def state_dir() -> Path:
    if os.environ.get("OMP_TASK_HOME"):
        return Path(os.environ["OMP_TASK_HOME"]).expanduser()
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(base) / "claude-omp"


def config_file() -> Path:
    if os.environ.get("OMP_TASK_CONFIG"):
        return Path(os.environ["OMP_TASK_CONFIG"]).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "claude-omp" / "config.json"


def load_config() -> dict:
    path = config_file()
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        die(f"invalid JSON in {path}: {exc}")
    return {}


def jobs_dir() -> Path:
    d = state_dir() / "jobs"
    d.mkdir(parents=True, exist_ok=True)
    return d


def omp_bin() -> str:
    candidate = os.environ.get("OMP_TASK_OMP_BIN", "omp")
    resolved = shutil.which(candidate)
    if not resolved:
        die(f"'{candidate}' not found on PATH. Install omp or set OMP_TASK_OMP_BIN.")
    return resolved


def die(msg: str, code: int = 2) -> None:
    print(f"omp-task: {msg}", file=sys.stderr)
    sys.exit(code)


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


# ---------------------------------------------------------------- job records


def new_job_id() -> str:
    return datetime.now().strftime("%Y%m%d-%H%M%S-") + secrets.token_hex(2)


def job_path(job_id: str) -> Path:
    d = jobs_dir()
    exact = d / job_id
    if exact.is_dir():
        return exact
    matches = sorted(p for p in d.iterdir() if p.name.startswith(job_id) or p.name.endswith(job_id))
    if len(matches) == 1:
        return matches[0]
    if not matches:
        die(f"no job matching '{job_id}'")
    die(f"'{job_id}' is ambiguous: " + ", ".join(m.name for m in matches[:5]))
    raise AssertionError


def read_meta(jdir: Path) -> dict:
    return json.loads((jdir / "meta.json").read_text())


def write_meta(jdir: Path, meta: dict) -> None:
    tmp = jdir / "meta.json.tmp"
    tmp.write_text(json.dumps(meta, indent=2, ensure_ascii=False))
    tmp.replace(jdir / "meta.json")


def pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def refresh_status(jdir: Path, meta: dict) -> dict:
    """A detached job whose worker died without finalising is reported as failed."""
    if meta.get("status") == "running" and not pid_alive(meta.get("worker_pid")):
        meta = finalize(jdir, meta, exit_code=None)
    return meta


# ---------------------------------------------------------------- git helpers


def git_root(cwd: Path) -> Path | None:
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], cwd=cwd, capture_output=True, text=True, check=True
        )
        return Path(out.stdout.strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def git_snapshot(cwd: Path) -> dict[str, str] | None:
    """Map of dirty path -> content hash, so we can tell which files the worker touched."""
    root = git_root(cwd)
    if not root:
        return None
    out = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"],
        cwd=root, capture_output=True, text=True,
    ).stdout
    paths = []
    entries = out.split("\0")
    i = 0
    while i < len(entries):
        entry = entries[i]
        if len(entry) > 3:
            paths.append(entry[3:])
            if entry[0] in "RC":  # rename/copy: next entry is the source path
                i += 1
        i += 1
    snap = {}
    for p in paths:
        f = root / p
        if f.is_file():
            h = subprocess.run(["git", "hash-object", "--", str(f)], capture_output=True, text=True).stdout.strip()
            snap[p] = h
        else:
            snap[p] = "<deleted>"
    return snap


def changed_files(before: dict | None, after: dict | None) -> list[str] | None:
    if before is None or after is None:
        return None
    keys = set(before) | set(after)
    return sorted(k for k in keys if before.get(k) != after.get(k))


def without_state_dir(files: list[str] | None, cwd: Path) -> list[str] | None:
    """Drop our own job records when the state dir happens to live inside the repo."""
    root = git_root(cwd)
    if files is None or root is None:
        return files
    try:
        rel = state_dir().resolve().relative_to(root.resolve()).as_posix() + "/"
    except ValueError:
        return files
    return [f for f in files if not f.startswith(rel)]


# ---------------------------------------------------------------- event parsing


def summarize_events(events_file: Path) -> dict:
    """Pull the useful bits out of omp's --mode json event stream."""
    info: dict = {"session_id": None, "final_text": "", "stop_reason": None, "tools": {},
                  "cost_usd": 0.0, "tokens": 0, "model": None, "errors": [], "denied": []}
    if not events_file.exists():
        return info
    with events_file.open(errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            t = ev.get("type")
            if t == "session":
                info["session_id"] = ev.get("id")
            elif t == "tool_execution_start":
                name = ev.get("toolName", "?")
                info["tools"][name] = info["tools"].get(name, 0) + 1
            elif t == "tool_execution_end" and ev.get("isError"):
                name = ev.get("toolName")
                if "requires approval" in json.dumps(ev.get("result")):
                    if name not in info["denied"]:
                        info["denied"].append(name)
                else:
                    info["errors"].append(f"tool {name} failed")
            elif t == "message_end":
                msg = ev.get("message") or {}
                if msg.get("role") == "assistant":
                    usage = msg.get("usage") or {}
                    info["tokens"] += usage.get("totalTokens") or 0
                    info["cost_usd"] += (usage.get("cost") or {}).get("total") or 0.0
                    info["model"] = f"{msg.get('provider')}/{msg.get('model')}"
                    info["stop_reason"] = msg.get("stopReason")
                    text = "".join(
                        c.get("text", "") for c in msg.get("content") or [] if c.get("type") == "text"
                    ).strip()
                    if text:
                        info["final_text"] = text
                    if msg.get("errorMessage"):
                        info["errors"].append(str(msg["errorMessage"]))
    info["cost_usd"] = round(info["cost_usd"], 6)
    return info


# ---------------------------------------------------------------- running


def build_omp_command(meta: dict, prompt_file: Path) -> list[str]:
    cmd = [omp_bin(), "-p", "--mode", "json", "--no-title"]
    cmd += ACCESS[meta["access"]]
    if meta.get("model"):
        cmd += ["--model", meta["model"]]
    if meta.get("thinking"):
        cmd += ["--thinking", meta["thinking"]]
    if meta.get("timeout"):
        cmd += ["--max-time", str(meta["timeout"])]
    if meta.get("resume_session"):
        cmd += ["--resume", meta["resume_session"]]
    elif PREAMBLE_FILE.exists() and not meta.get("no_preamble"):
        cmd += ["--append-system-prompt", str(PREAMBLE_FILE)]
    for d in meta.get("add_dirs") or []:
        cmd += ["--add-dir", d]
    cmd += meta.get("extra_args") or []
    cmd += [f"@{f}" for f in meta.get("files") or []]
    cmd += [f"@{prompt_file}"]
    return cmd


def execute(jdir: Path) -> dict:
    """Run omp for a prepared job directory and finalise it. Blocks until omp exits."""
    meta = read_meta(jdir)
    cwd = Path(meta["cwd"])
    meta["git_before"] = git_snapshot(cwd)
    cmd = build_omp_command(meta, jdir / "prompt.md")
    meta.update(status="running", started_at=now_iso(), command=cmd, worker_pid=os.getpid())
    write_meta(jdir, meta)

    started = time.monotonic()
    with (jdir / "events.jsonl").open("w") as out, (jdir / "stderr.log").open("w") as err:
        proc = subprocess.Popen(cmd, cwd=cwd, stdout=out, stderr=err, stdin=subprocess.DEVNULL,
                                start_new_session=True)
        meta["omp_pid"] = proc.pid
        write_meta(jdir, meta)

        def forward(signum, _frame):
            try:
                os.killpg(proc.pid, signum)
            except ProcessLookupError:
                pass

        signal.signal(signal.SIGTERM, forward)
        signal.signal(signal.SIGINT, forward)
        exit_code = proc.wait()

    meta = read_meta(jdir)
    meta["duration_s"] = round(time.monotonic() - started, 1)
    return finalize(jdir, meta, exit_code)


def finalize(jdir: Path, meta: dict, exit_code: int | None) -> dict:
    info = summarize_events(jdir / "events.jsonl")
    before = meta.pop("git_before", None)
    after = git_snapshot(Path(meta["cwd"]))
    if meta.get("status") == "cancelling":
        status = "cancelled"
    elif exit_code is None:
        status = "failed"
        info["errors"].append("worker exited without recording a result")
    elif exit_code == 0 and info["stop_reason"] in (None, "stop", "end_turn", "toolUse"):
        status = "completed"
    elif info["stop_reason"] == "aborted" or exit_code in (124, -signal.SIGTERM):
        status = "timeout" if meta.get("timeout") else "cancelled"
    else:
        status = "failed"
    if status == "failed" and exit_code not in (None, 0):
        tail = (jdir / "stderr.log").read_text(errors="replace")[-800:].strip()
        if tail:
            info["errors"].append(tail)
    meta.update(
        status=status,
        exit_code=exit_code,
        finished_at=now_iso(),
        session_id=info["session_id"] or meta.get("resume_session"),
        model_used=info["model"],
        stop_reason=info["stop_reason"],
        tools=info["tools"],
        tokens=info["tokens"],
        cost_usd=info["cost_usd"],
        errors=info["errors"][-5:],
        denied_tools=info["denied"],
        changed_files=without_state_dir(changed_files(before, after), Path(meta["cwd"])),
    )
    meta.pop("worker_pid", None)
    (jdir / "result.md").write_text(info["final_text"])
    write_meta(jdir, meta)
    return meta


def prepare_job(args, prompt: str, parent: dict | None = None) -> Path:
    cfg = load_config()
    preset = {}
    if getattr(args, "preset", None):
        preset = (cfg.get("presets") or {}).get(args.preset)
        if preset is None:
            die(f"unknown preset '{args.preset}' (define it in {config_file()})")
    defaults = cfg.get("defaults") or {}

    def pick(key, fallback=None):
        val = getattr(args, key, None)
        if val is not None:
            return val
        if key in preset:
            return preset[key]
        if parent and key in parent:
            return parent[key]
        return defaults.get(key, fallback)

    cwd = Path(args.cwd or (parent or {}).get("cwd") or os.getcwd()).resolve()
    if not cwd.is_dir():
        die(f"cwd does not exist: {cwd}")

    job_id = new_job_id()
    jdir = jobs_dir() / job_id
    jdir.mkdir()
    (jdir / "prompt.md").write_text(prompt)
    meta = {
        "id": job_id,
        "version": VERSION,
        "status": "queued",
        "created_at": now_iso(),
        "cwd": str(cwd),
        "title": args.title or first_line(prompt),
        "access": pick("access", "edit"),
        "model": pick("model"),
        "thinking": pick("thinking"),
        "timeout": pick("timeout", "30m"),
        "add_dirs": [str(Path(d).resolve()) for d in (args.add_dir or [])],
        "files": [str(Path(f).resolve()) for f in (getattr(args, "file", None) or [])],
        "extra_args": shlex.split(pick("omp_args", "") or ""),
        "no_preamble": bool(getattr(args, "no_preamble", False)),
        "parent": parent["id"] if parent else None,
        "resume_session": parent.get("session_id") if parent else None,
    }
    if meta["access"] not in ACCESS:
        die(f"access must be one of {', '.join(ACCESS)}")
    write_meta(jdir, meta)
    return jdir


def first_line(text: str) -> str:
    for line in text.splitlines():
        line = re.sub(r"^[#>*\-\s]+", "", line).strip()
        if line:
            return line[:80]
    return "(untitled)"


def launch(jdir: Path, detach: bool, as_json: bool) -> int:
    if not detach:
        meta = execute(jdir)
        emit(jdir, meta, as_json)
        return 0 if meta["status"] == "completed" else 1
    log = (jdir / "worker.log").open("w")
    proc = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "_worker", str(jdir)],
        stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True,
    )
    meta = read_meta(jdir)
    meta.update(status="running", worker_pid=proc.pid)
    write_meta(jdir, meta)
    if as_json:
        print(json.dumps({"id": meta["id"], "status": "running"}))
    else:
        print(f"job {meta['id']} started in background (pid {proc.pid})")
        print(f"  check:  omp-task status {meta['id']}")
        print(f"  wait:   omp-task wait {meta['id']}")
    return 0


# ---------------------------------------------------------------- output


def emit(jdir: Path, meta: dict, as_json: bool, full: bool = False) -> None:
    result = (jdir / "result.md").read_text() if (jdir / "result.md").exists() else ""
    truncated = False
    if not full and len(result) > RESULT_CHAR_LIMIT:
        result = result[:RESULT_CHAR_LIMIT]
        truncated = True
    if as_json:
        keys = ["id", "status", "title", "cwd", "access", "model", "model_used", "session_id", "parent",
                "duration_s", "cost_usd", "tokens", "tools", "changed_files", "denied_tools", "errors", "created_at",
                "finished_at"]
        out = {k: meta.get(k) for k in keys}
        out["result"] = result
        out["result_truncated"] = truncated
        out["job_dir"] = str(jdir)
        print(json.dumps(out, indent=2, ensure_ascii=False))
        return
    print(f"## omp job {meta['id']} — {meta.get('status', '?').upper()}")
    print(f"- title: {meta.get('title')}")
    print(f"- cwd: {meta.get('cwd')}  access: {meta.get('access')}")
    model = meta.get("model_used") or meta.get("model") or "(omp default)"
    print(f"- model: {model}  session: {meta.get('session_id') or '-'}")
    if meta.get("duration_s") is not None:
        print(f"- duration: {meta['duration_s']}s  tokens: {meta.get('tokens', 0)}  cost: ${meta.get('cost_usd', 0):.4f}")
    if meta.get("tools"):
        print("- tools: " + ", ".join(f"{k}×{v}" for k, v in sorted(meta["tools"].items())))
    cf = meta.get("changed_files")
    if cf is not None:
        print("- changed files: " + (", ".join(cf) if cf else "(none)"))
    if meta.get("denied_tools"):
        print(f"- denied by access '{meta.get('access')}': " + ", ".join(meta["denied_tools"]))
    for e in meta.get("errors") or []:
        print(f"- error: {e}")
    print()
    print(result or "(no final message)")
    if truncated:
        print(f"\n[truncated — full text: omp-task result {meta['id']} --full]")


# ---------------------------------------------------------------- commands


def read_prompt(args) -> str:
    parts = []
    if args.brief:
        parts.append(sys.stdin.read() if args.brief == "-" else Path(args.brief).read_text())
    if args.prompt:
        parts.append(" ".join(args.prompt))
    text = "\n\n".join(p.strip() for p in parts if p.strip())
    if not text:
        die("no task given: pass a prompt, or --brief FILE (use '-' for stdin)")
    return text


def cmd_run(args) -> int:
    jdir = prepare_job(args, read_prompt(args))
    return launch(jdir, args.detach, args.json)


def cmd_continue(args) -> int:
    parent_dir = job_path(args.job)
    parent = refresh_status(parent_dir, read_meta(parent_dir))
    if parent.get("status") == "running":
        die(f"job {parent['id']} is still running; wait for it first")
    if not parent.get("session_id"):
        die(f"job {parent['id']} has no omp session to continue")
    jdir = prepare_job(args, read_prompt(args), parent=parent)
    return launch(jdir, args.detach, args.json)


def cmd_status(args) -> int:
    jdir = job_path(args.job)
    meta = refresh_status(jdir, read_meta(jdir))
    if meta["status"] in TERMINAL:
        emit(jdir, meta, args.json)
    else:
        info = summarize_events(jdir / "events.jsonl")
        snapshot = {"id": meta["id"], "status": meta["status"], "title": meta.get("title"),
                    "started_at": meta.get("started_at"), "tools_so_far": info["tools"],
                    "session_id": info["session_id"]}
        print(json.dumps(snapshot, indent=2) if args.json else
              f"{meta['id']} {meta['status']} — {meta.get('title')} — tools so far: "
              + (", ".join(f"{k}×{v}" for k, v in info["tools"].items()) or "none"))
    return 0


def cmd_wait(args) -> int:
    deadline = time.monotonic() + args.max_wait if args.max_wait else None
    dirs = [job_path(j) for j in args.jobs]
    while True:
        metas = [refresh_status(d, read_meta(d)) for d in dirs]
        if all(m["status"] in TERMINAL for m in metas):
            break
        if deadline and time.monotonic() > deadline:
            for m in metas:
                print(f"{m['id']} {m['status']}")
            return 3
        time.sleep(args.interval)
    for d, m in zip(dirs, metas):
        emit(d, m, args.json)
        print()
    return 0 if all(m["status"] == "completed" for m in metas) else 1


def cmd_result(args) -> int:
    jdir = job_path(args.job)
    meta = refresh_status(jdir, read_meta(jdir))
    emit(jdir, meta, args.json, full=args.full)
    return 0


def cmd_list(args) -> int:
    rows = []
    for d in sorted(jobs_dir().iterdir(), reverse=True):
        if not (d / "meta.json").exists():
            continue
        meta = refresh_status(d, read_meta(d))
        if args.cwd and meta.get("cwd") != str(Path(args.cwd).resolve()):
            continue
        if args.status and meta.get("status") != args.status:
            continue
        rows.append(meta)
        if len(rows) >= args.limit:
            break
    if args.json:
        print(json.dumps([{k: m.get(k) for k in ("id", "status", "title", "cwd", "model_used", "cost_usd",
                                                    "parent")} for m in rows], indent=2))
        return 0
    for m in rows:
        print(f"{m['id']}  {m.get('status', '?'):<9}  {m.get('title', '')[:60]}  [{m.get('cwd')}]")
    if not rows:
        print("(no jobs)")
    return 0


def cmd_cancel(args) -> int:
    jdir = job_path(args.job)
    meta = read_meta(jdir)
    if meta.get("status") in TERMINAL:
        print(f"job {meta['id']} already {meta['status']}")
        return 0
    meta["status"] = "cancelling"
    write_meta(jdir, meta)
    for key in ("omp_pid", "worker_pid"):
        pid = meta.get(key)
        if pid_alive(pid):
            try:
                os.killpg(pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                pass
    print(f"cancel requested for job {meta['id']}")
    return 0


def cmd_doctor(args) -> int:
    ok = True
    binary = shutil.which(os.environ.get("OMP_TASK_OMP_BIN", "omp"))
    print(f"omp binary:   {binary or 'NOT FOUND'}")
    ok &= bool(binary)
    if binary:
        ver = subprocess.run([binary, "--version"], capture_output=True, text=True).stdout.strip()
        print(f"omp version:  {ver}")
    print(f"python:       {sys.version.split()[0]}")
    print(f"state dir:    {state_dir()}")
    cfg = config_file()
    print(f"config:       {cfg} ({'present' if cfg.exists() else 'absent, using defaults'})")
    presets = (load_config().get("presets") or {})
    if presets:
        print("presets:      " + ", ".join(presets))
    print(f"preamble:     {PREAMBLE_FILE} ({'ok' if PREAMBLE_FILE.exists() else 'missing'})")
    return 0 if ok else 1


def cmd_worker(args) -> int:
    execute(Path(args.job_dir))
    return 0


# ---------------------------------------------------------------- CLI


def add_task_args(p: argparse.ArgumentParser) -> None:
    p.add_argument("prompt", nargs="*", help="task text (combined with --brief if both given)")
    p.add_argument("-b", "--brief", help="read the task from a file ('-' for stdin)")
    p.add_argument("-m", "--model", help="omp model or role: e.g. smol, slow, plan, task, 'openai/gpt-6-luna'")
    p.add_argument("-p", "--preset", help="named preset from the config file")
    p.add_argument("-a", "--access", choices=list(ACCESS), help="read | edit (default) | full")
    p.add_argument("-t", "--thinking", help="off|minimal|low|medium|high|xhigh|max|auto")
    p.add_argument("--timeout", help="omp --max-time, e.g. 600, 20m, 1h (default 30m)")
    p.add_argument("-C", "--cwd", help="directory omp works in (default: current)")
    p.add_argument("--add-dir", action="append", help="extra workspace directory (repeatable)")
    p.add_argument("-f", "--file", action="append", help="attach a file to the prompt (repeatable)")
    p.add_argument("--title", help="short label for job listings")
    p.add_argument("--omp-args", help="extra raw omp flags, shell-quoted")
    p.add_argument("--no-preamble", action="store_true", help="skip the worker preamble system prompt")
    p.add_argument("-d", "--detach", action="store_true", help="run in background; returns the job id")
    p.add_argument("--json", action="store_true", help="machine-readable output")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="omp-task", description=__doc__.splitlines()[0])
    parser.add_argument("--version", action="version", version=f"omp-task {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("run", help="start a new task")
    add_task_args(p)
    p.set_defaults(fn=cmd_run)

    p = sub.add_parser("continue", help="send a follow-up into a finished job's omp session")
    p.add_argument("job")
    add_task_args(p)
    p.set_defaults(fn=cmd_continue)

    p = sub.add_parser("status", help="show a job's state (live tool counts while running)")
    p.add_argument("job")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("wait", help="block until jobs finish, then print their results")
    p.add_argument("jobs", nargs="+")
    p.add_argument("--interval", type=float, default=3.0)
    p.add_argument("--max-wait", type=float, help="give up after N seconds (exit 3)")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_wait)

    p = sub.add_parser("result", help="print a job's result")
    p.add_argument("job")
    p.add_argument("--full", action="store_true", help="do not truncate the final message")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_result)

    p = sub.add_parser("list", help="list recent jobs")
    p.add_argument("-n", "--limit", type=int, default=20)
    p.add_argument("-C", "--cwd", help="only jobs for this directory")
    p.add_argument("--status", choices=sorted(TERMINAL | {"running", "queued"}))
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("cancel", help="stop a running job")
    p.add_argument("job")
    p.set_defaults(fn=cmd_cancel)

    p = sub.add_parser("doctor", help="check the omp install and configuration")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("_worker", help=argparse.SUPPRESS)
    p.add_argument("job_dir")
    p.set_defaults(fn=cmd_worker)

    args = parser.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
