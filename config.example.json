{
  "defaults": {
    "access": "edit",
    "timeout": "30m",
    "allow": ["git status*", "git diff*", "git log*"]
  },
  "presets": {
    "cheap": {
      "model": "smol",
      "access": "edit",
      "timeout": "20m"
    },
    "builder": {
      "model": "default",
      "access": "full",
      "isolate": "worktree",
      "timeout": "45m",
      "budget": 1.5
    },
    "reviewer": {
      "model": "slow",
      "access": "read",
      "thinking": "high",
      "timeout": "20m"
    },
    "designer": {
      "model": "designer",
      "access": "edit"
    }
  },
  "max_concurrent": 4,
  "max_writers_per_repo": 1,
  "daily_budget_usd": 10,
  "on_session_end": "keep",
  "stop_gate": {
    "enabled": false,
    "model": "smol",
    "timeout": "3m",
    "min_severity": "high",
    "max_per_session": 3
  }
}
