{
	"name": "claude-omp",
	"version": "1.2.2",
	"private": true,
	"description": "Claude Code orchestrates omp workers: delegate, supervise, isolate, review.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "bun run typecheck && bun run lint && bun test",
		"record": "bun run scripts/record-rpc.ts",
		"build": "bun run scripts/build.ts",
		"contract": "OMP_CONTRACT=1 bun test tests/contract"
	},
	"dependencies": {
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/bun": "1.4.4",
		"typescript": "7.0.2"
	}
}
